# Kopiuj poza repozytorium i uzupełnij osobne sekrety oraz bezwzględne ścieżki.
# docker compose --env-file /ścieżka/test.env -f deploy/compose.yaml up -d --build
COMPOSE_PROJECT_NAME=prestashop-d21-tests
PS_DOMAIN=localhost:18080
PS_ENABLE_SSL=0
DB_NAME=prestashop
DB_USER=prestashop
DB_PASSWORD=
DB_ROOT_PASSWORD=
ADMIN_EMAIL=api-test@example.test
ADMIN_PASSWORD=
PRESTASHOP_API_KEY=
PRESTASHOP_API_URL=http://localhost:18080/api
PRESTASHOP_API_VERIFY_SSL=true
HTTP_PORT=18080
HTTPS_PORT=18443
MAILPIT_PORT=18025
NGINX_CONFIG=./nginx/api-test.conf
TLS_CERT_DIR=
# Kompletny katalog: products.json, categories.json oraz images/.
SCRAPER_RESULTS_DIR=
# Zachowanie wolumenów instancji utworzonej przed połączeniem konfiguracji.
# Dla nowej instancji można pominąć te dwa ustawienia i korzystać z nazw projektu.
DB_VOLUME_NAME=prestashop-d21-tests_api_test_db
SHOP_VOLUME_NAME=prestashop-d21-tests_api_test_shop
