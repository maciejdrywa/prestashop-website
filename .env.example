# Nazwa projektu wyznacza nazwy kontenerów i wolumenów.
COMPOSE_PROJECT_NAME=prestashop-website

# Lokalna domena zgodna z konfiguracją Nginx i certyfikatem.
PS_DOMAIN=localhost

# Bezwzględna ścieżka katalogu certyfikatów, uzupełniana w lokalnym .env.
TLS_CERT_DIR=

# Baza i konto aplikacji tworzone podczas pierwszej instalacji.
DB_NAME=prestashop
DB_USER=prestashop

# Hasła wymagane w lokalnym .env.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Konto administratora tworzone podczas pierwszej instalacji.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# Konfiguracja PrestaShop Webservice API
PRESTASHOP_API_URL=https://localhost/api
# 32-znakowy klucz alfanumeryczny
PRESTASHOP_API_KEY=
# Weryfikacja TLS: false tylko dla lokalnego self-signed; true dla zaufanego certyfikatu.
# Dodatkowy CA: standardowa zmienna REQUESTS_CA_BUNDLE ze ścieżką do certyfikatu.
PRESTASHOP_API_VERIFY_SSL=false

# Opcjonalne ustawienia jednej definicji Compose (domyślne wartości sklepu).
HTTP_PORT=80
HTTPS_PORT=443
MAILPIT_PORT=8025
SCRAPER_RESULTS_DIR=../scraper-results
NGINX_CONFIG=./nginx/default.conf
# Testy: deploy/api-test.env.example, osobna nazwa projektu i osobne hasła.
# DB_VOLUME_NAME i SHOP_VOLUME_NAME służą wyłącznie do jawnego wskazania starych wolumenów.
