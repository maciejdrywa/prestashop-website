# Nazwa projektu wyznacza nazwy kontenerów i wolumenów.
COMPOSE_PROJECT_NAME=prestashop-website

# Lokalna domena zgodna z konfiguracją Nginx i certyfikatem.
PS_DOMAIN=localhost

# Bezwzględna ścieżka katalogu certyfikatów, uzupełniana w lokalnym .env.
TLS_CERT_DIR=

# Baza i konto aplikacji tworzone podczas pierwszej instalacji.
DB_NAME=prestashop
DB_USER=prestashop

# Hasła wymagane w lokalnym .env.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Konto administratora tworzone podczas pierwszej instalacji.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# Konfiguracja PrestaShop Webservice API
PRESTASHOP_API_URL=https://localhost/api
# 32-znakowy klucz alfanumeryczny
PRESTASHOP_API_KEY=
# Ignorowanie weryfikacji lokalnego certyfikatu self-signed (true/false)
PRESTASHOP_API_VERIFY_SSL=false
