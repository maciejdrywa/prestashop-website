# Name of the project.
COMPOSE_PROJECT_NAME=prestashop-website

# App address — bez http://.
PS_DOMAIN=localhost

# Absolute path outside the repository; set in local .env.
TLS_CERT_DIR=

# Database configuration.
DB_NAME=prestashop
DB_USER=prestashop

# To complete in .env
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Admin credentials.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=